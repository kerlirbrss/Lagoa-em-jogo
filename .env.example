# ============================================================
# Lagoa em Jogo - configuracoes de ambiente
# Copie para .env e ajuste antes de subir em producao.
# ============================================================

# Ambiente (development ou production)
NODE_ENV=production
PORT=3000
APP_NAME=Lagoa em Jogo

# Segredo de sessao (gere um valor unico de 32+ caracteres)
SESSION_SECRET=troque-este-valor-por-um-segredo-forte-e-unico

# --- Fase 17 - Deploy ---
# Confiar nos cabecalhos do proxy reverso (Nginx/Caddy/Render)
LEJ_TRUST_PROXY=1
# Redirecionar todo trafego HTTP para HTTPS
LEJ_FORCE_HTTPS=1
# Marcar cookies de sessao como Secure
LEJ_SECURE_COOKIES=1
# Caminho do banco de dados persistente
LEJ_DB_PATH=./backend/database/db.json
# Registrar cada requisicao em log estruturado (JSON)
LEJ_LOG_REQUESTS=1

# Backup automatico
LEJ_BACKUP_DIR=./backups
LEJ_BACKUP_KEEP=14

# Monitoramento
LEJ_MONITOR_URL=http://localhost:3000
LEJ_MONITOR_TIMEOUT_MS=5000
